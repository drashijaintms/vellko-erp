<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Permanent Redirect: Force WWW to NON-WWW (https://www.vellkoerp.com/* -> https://vellkoerp.com/*)
  RewriteCond %{HTTP_HOST} ^www\.vellkoerp\.com$ [NC]
  RewriteRule ^(.*)$ https://vellkoerp.com/$1 [R=301,L]

  # 2. 301 Permanent Redirect: Force HTTPS on non-www (http://vellkoerp.com/* -> https://vellkoerp.com/*)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^vellkoerp\.com$ [NC]
  RewriteRule ^(.*)$ https://vellkoerp.com/$1 [R=301,L]

  # 3. Single Page Application (SPA) Routing for React Router
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
