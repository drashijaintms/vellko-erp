# Disable directory listing and MultiViews
Options -Indexes -MultiViews

# Disable automatic directory trailing slash redirects in LiteSpeed / Apache
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS + Non-WWW (301 Permanent Redirect)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.vellkoerp\.com$ [NC]
    RewriteRule ^(.*)$ https://vellkoerp.com/$1 [R=301,L]

    # 2. Redirect Trailing Slash to Non-Trailing Slash (301 Permanent Redirect)
    # Examples: /crm-lead-management/ -> /crm-lead-management
    #           /about/ -> /about
    #           /blog/some-slug/ -> /blog/some-slug
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+(.+?)/+[\s?] [NC]
    RewriteRule ^ /%1 [R=301,NE,L]

    # 3. Redirect legacy /ecommerce-erp to /e-commerce-erp (301 Permanent Redirect)
    RewriteRule ^ecommerce-erp/?$ /e-commerce-erp [R=301,L,NC]

    # 3. Allow real physical files directly (CSS, JS, images, fonts, uploads, sitemap.xml, robots.txt)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Serve Pre-Rendered HTML directly with 200 OK (Clean URLs)
    # 4a. Single-segment clean URL (e.g. /crm-lead-management -> crm-lead-management.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)$ $1.html [L]

    # 4b. Nested clean URL (e.g. /blog/some-slug -> blog/some-slug.html)
    RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
    RewriteRule ^([^/]+)/([^/]+)$ $1/$2.html [L]

    # 5. Allow physical directories if any (e.g. /uploads, /api)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. React SPA Router fallback for client-side routing
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# Custom Error Document
ErrorDocument 404 /index.html