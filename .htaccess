Options -Indexes -MultiViews

<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS + Non-WWW (301 Permanent Redirect)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.vellkoerp\.com$ [NC]
    RewriteRule ^(.*)$ https://vellkoerp.com/$1 [R=301,L]

    # 2. Redirect Trailing Slash to Non-Slash (except actual directories)
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+(.+?)/+[\s?] [NC]
    RewriteCond %{DOCUMENT_ROOT}/%1 !-d
    RewriteRule ^ /%1 [R=301,NE,L]

    # 3. 301 Redirects
    RewriteRule ^ecommerce-erp/?$ /e-commerce-erp [R=301,L,NC]

    # 4. Direct API Endpoints for cPanel Backend
    RewriteRule ^api/upload/?$ api/upload.php [L,QSA]
    RewriteRule ^api/uploads/?$ api/uploads.php [L,QSA]
    RewriteRule ^api/blogs/?(.*)$ api/blogs.php?path=$1 [L,QSA]
    RewriteRule ^api/contact/?(.*)$ api/contact.php?path=$1 [L,QSA]

    # 5. Allow existing physical files and directories directly
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. Serve Pre-Rendered HTML for clean URLs (Single-level routes: /privacy-policy -> privacy-policy.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)$ $1.html [L]

    # 7. Serve Pre-Rendered HTML for nested clean URLs (e.g. /blog/slug -> blog/slug.html)
    RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)/([^/]+)$ $1/$2.html [L]

    # 8. Dynamic SPA Route (Blog Admin)
    RewriteRule ^blog/admin(/.*)?$ index.html [L]
</IfModule>
