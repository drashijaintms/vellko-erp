<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable directory listing and MultiViews
    Options -Indexes -MultiViews

    # 1. Force HTTPS + Non-WWW (301 Permanent Redirect)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.vellkoerp\.com$ [NC]
    RewriteRule ^(.*)$ https://vellkoerp.com/$1 [R=301,L]

    # 2. Allow existing files and folders to be served directly (css, js, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Rewrite all frontend routes to index.html for React Router
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# LiteSpeed / Apache 404 fallback to React SPA
ErrorDocument 404 /index.html
