Options -Indexes -MultiViews

<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS + Non-WWW
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.vellkoerp\.com$ [NC]
    RewriteRule ^(.*)$ https://vellkoerp.com/$1 [R=301,L]

    # 2. Redirect Slash to Non-Slash (301 Permanent Redirect)
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+(.+?)/+[\s?] [NC]
    RewriteRule ^ /%1 [R=301,NE,L]

    # 301 Redirects
    RewriteRule ^ecommerce-erp/?$ /e-commerce-erp [R=301,L,NC]

    # 3. Allow real static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Serve Pre-Rendered HTML directly with 200 OK
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)$ $1.html [L]

    # 4b. Nested clean URLs
    RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
    RewriteRule ^([^/]+)/([^/]+)$ $1/$2.html [L]

    # 5. SPA Fallback
    RewriteRule ^ index.html [QSA,L]
</IfModule>

ErrorDocument 404 /index.html